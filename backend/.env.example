# Copy this file to .env and replace YOUR_MYSQL_PASSWORD with your MySQL account password.
# If your password contains @, :, /, # or %, URL-encode those characters.
DATABASE_URL=mysql+pymysql://root:YOUR_MYSQL_PASSWORD@127.0.0.1:3306/symbioloop
JWT_SECRET=replace-with-a-long-random-secret-before-use
TOKEN_MINUTES=720
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional future LLM provider key; rule-based assistant works without it.
# OPENAI_API_KEY=
